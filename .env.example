# Trusted shell configuration, owner-only permissions. Store real values outside Git.
BACKUP_SOURCE=/srv/application/backup-input
BACKUP_STATE_DIR=/var/lib/application-backup
BACKUP_HOST=application-production
RESTIC_REPOSITORY=s3:https://s3.ap-south-1.amazonaws.com/REPLACE_BUCKET/production
RESTIC_PASSWORD_FILE=/etc/application-backup/password
AWS_DEFAULT_REGION=ap-south-1
# Prefer an instance/workload role. Otherwise use scoped storage credentials.
# AWS_ACCESS_KEY_ID=REPLACE
# AWS_SECRET_ACCESS_KEY=REPLACE
# Alternative: RESTIC_REPOSITORY=gs:REPLACE_BUCKET:/production
# Optional owner-managed script creates a consistent database dump into BACKUP_SOURCE.
PRE_BACKUP_SCRIPT=
APPLY_RETENTION=0
KEEP_DAILY=7
KEEP_WEEKLY=4
